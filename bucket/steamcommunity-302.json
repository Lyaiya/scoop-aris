    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall' -and $purge) {",
            "    if (Get-Process -Name 'Steamcommunity_302', 'steamcommunity_302.cli' -ErrorAction SilentlyContinue) {",
            "        throw 'Stop the Steamcommunity 302 service and exit the application before purging.'",
            "    }",
            "    $appDataDir = \"$env:APPDATA\\Steamcommunity_302.exe\"",
            "    info \"Removing Steamcommunity 302 WebView2 data at '$appDataDir'...\"",
            "    Remove-Item -LiteralPath $appDataDir -Recurse -Force -ErrorAction SilentlyContinue",
            "    $cleanupCommands = @()",
            "    $task = Get-ScheduledTask -ErrorAction Stop | Where-Object { $_.TaskPath -eq '\\' -and $_.TaskName -eq 'Steamcommunity302 V15 UI' }",
            "    if ($task) {",
            "        info \"Removing Steamcommunity 302 startup task '$($task.TaskName)'...\"",
            "        $cleanupCommands += \"Unregister-ScheduledTask -TaskPath '\\' -TaskName 'Steamcommunity302 V15 UI' -Confirm:`$false -ErrorAction Stop\"",
            "    }",
            "    $certificatePattern = '^CN=Steamcommunity302 - \\d{4} ECC Root$'",
            "    $userCertificates = Get-ChildItem -LiteralPath Cert:\\CurrentUser\\Root -ErrorAction Stop | Where-Object Subject -match $certificatePattern",
            "    foreach ($certificate in $userCertificates) {",
            "        if (Test-Path -LiteralPath \"HKCU:\\Software\\Microsoft\\SystemCertificates\\Root\\Certificates\\$($certificate.Thumbprint)\") {",
            "            $certPath = \"Cert:\\CurrentUser\\Root\\$($certificate.Thumbprint)\"",
            "            info \"Removing Steamcommunity 302 root certificate at '$certPath'...\"",
            "            Remove-Item -LiteralPath $certPath -Force -ErrorAction Stop",
            "        }",
            "    }",
            "    $machineCertificates = Get-ChildItem -LiteralPath Cert:\\LocalMachine\\Root -ErrorAction Stop | Where-Object Subject -match $certificatePattern",
            "    foreach ($certificate in $machineCertificates) {",
            "        $certPath = \"Cert:\\LocalMachine\\Root\\$($certificate.Thumbprint)\"",
            "        info \"Removing Steamcommunity 302 root certificate at '$certPath'...\"",
            "        $cleanupCommands += \"Remove-Item -LiteralPath '$certPath' -Force -ErrorAction Stop\"",
            "    }",
            "    $programDataDir = \"$env:ProgramData\\Steamcommunity_302\"",
            "    if (Test-Path -LiteralPath $programDataDir) {",
            "        info \"Removing Steamcommunity 302 data at '$programDataDir'...\"",
            "        $cleanupCommands += \"Remove-Item -LiteralPath '$($programDataDir.Replace(\"'\", \"''\"))' -Recurse -Force -ErrorAction Stop\"",
            "    }",
            "    if ($cleanupCommands.Count -gt 0) {",
            "        $command = $cleanupCommands -join \"`r`n\"",
            "        if (is_admin) {",
            "            & ([scriptblock]::Create($command))",
            "        } else {",
            "            $errorLog = [IO.Path]::GetTempFileName()",
            "            try {",
            "                $command = \"try {`r`n$command`r`n} catch {`r`n    [IO.File]::WriteAllText('$($errorLog.Replace(\"'\", \"''\"))', (`$_ | Out-String -Width 4096))`r`n    exit 1`r`n}\"",
            "                $encodedCommand = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($command))",
            "                if (!(Invoke-ExternalCommand -FilePath (Get-Process -Id $PID).Path -ArgumentList @('-NoProfile', '-NonInteractive', '-EncodedCommand', $encodedCommand) -RunAs -Quiet)) {",
            "                    $details = [IO.File]::ReadAllText($errorLog).Trim()",
            "                    if (!$details) { $details = 'Elevation was cancelled or cleanup failed without error details.' }",
            "                    throw \"Failed to clean up Steamcommunity 302 startup tasks, certificates or data.`r`n$details\"",
            "                }",
            "            } finally {",
            "                Remove-Item -LiteralPath $errorLog -Force -ErrorAction SilentlyContinue",
            "            }",
            "        }",
            "    }",
            "}"
        ]
